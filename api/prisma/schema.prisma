generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  company   String?
  role      String?
  status    LeadStatus @default(NEW)
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts EmailDraft[]
  sends  EmailSend[]
}

model EmailDraft {
  id        String   @id @default(uuid())
  leadId    String
  subject   String
  body      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

model EmailSend {
  id        String   @id @default(uuid())
  leadId    String
  type      EmailType
  provider  String
  status    SendStatus
  sentAt    DateTime

  lead Lead @relation(fields: [leadId], references: [id])
}

enum LeadStatus {
  NEW
  EMAIL_SENT
}

enum EmailType {
  INITIAL
  FOLLOW_UP
}

enum SendStatus {
  SENT
  FAILED
}
